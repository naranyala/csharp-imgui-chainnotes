<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ChainNotes</RootNamespace>
    <AssemblyName>ChainNotes</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <!--
    Silk.NET resolves native libraries (GLFW, cimgui) from the app base directory first.
    Copy the runtime-specific native libs into the output root so the app launches even when
    the dependency-context RID graph can't resolve them (seen on some distros).
  -->
  <Target Name="CopyNativeLibsToOutput" AfterTargets="Build" Condition="'$(OutputType)' == 'Exe'">
    <PropertyGroup>
      <_NativeRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">linux-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_NativeRid>
      <_NativeRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">osx-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_NativeRid>
      <_NativeRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_NativeRid>
    </PropertyGroup>
    <ItemGroup>
      <_NativeLibs Include="$(OutputPath)runtimes\**\native\*" />
      <_NativeLibsToCopy Include="@(_NativeLibs)" Condition="$([System.String]::Copy('%(RelativeDir)').Replace('\','/').Contains('runtimes/$(_NativeRid)/native/'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeLibsToCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native libs (@(_NativeLibsToCopy->Count()) file(s)) for $(_NativeRid) to $(OutputPath)" />
  </Target>

</Project>
